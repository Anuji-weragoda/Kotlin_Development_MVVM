<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@android:color/white"
    android:foreground="?android:attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Flag/Globe Icon Container -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/flagContainer"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#E8F5E9"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/countryIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_flag_filled"
                app:tint="#2E7D32"/>

        </com.google.android.material.card.MaterialCardView>

        <!-- Country Name -->
        <TextView
            android:id="@+id/countryNameText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="12dp"
            android:text="Country Name"
            android:textSize="16sp"
            android:textColor="#212121"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/flagContainer"
            app:layout_constraintEnd_toStartOf="@id/arrowIcon"
            app:layout_constraintTop_toTopOf="@id/flagContainer"
            app:layout_constraintBottom_toTopOf="@id/regionText"/>

        <!-- Region/Continent -->
        <TextView
            android:id="@+id/regionText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="4dp"
            android:text="Region • Continent"
            android:textSize="13sp"
            android:textColor="#757575"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/flagContainer"
            app:layout_constraintEnd_toStartOf="@id/arrowIcon"
            app:layout_constraintTop_toBottomOf="@id/countryNameText"
            app:layout_constraintBottom_toBottomOf="@id/flagContainer"/>

        <!-- Arrow Icon -->
        <ImageView
            android:id="@+id/arrowIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_media_play"
            android:rotation="180"
            app:tint="#BDBDBD"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>