<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/countryFragment">

    <!-- Country Fragment (temporary start) -->
    <fragment
        android:id="@+id/countryFragment"
        android:name="com.example.androidapp.ui.country.CountryFragment"
        android:label="Countries">

        <!-- Optional: navigate to login page from here -->
        <action
            android:id="@+id/action_countryFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/countryFragment"
            app:popUpToInclusive="true"/>
    </fragment>

    <!-- Splash Fragment -->
    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.androidapp.ui.splash.SplashFragment"
        android:label="Splash">

        <action
            android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true"
            app:enterAnim="@android:anim/fade_in"
            app:exitAnim="@android:anim/fade_out" />
    </fragment>

    <!-- Login Fragment -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.androidapp.ui.auth.login.LoginFragment"
        android:label="Login">

        <!-- Navigate to Signup -->
        <action
            android:id="@+id/action_loginFragment_to_signupFragment"
            app:destination="@id/signupFragment"
            app:enterAnim="@android:anim/slide_in_left"
            app:exitAnim="@android:anim/slide_out_right"
            app:popEnterAnim="@android:anim/slide_in_left"
            app:popExitAnim="@android:anim/slide_out_right" />

        <!-- Navigate to Home after successful login -->
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true"/>
    </fragment>

    <!-- Signup Fragment -->
    <fragment
        android:id="@+id/signupFragment"
        android:name="com.example.androidapp.ui.auth.signup.SignupFragment"
        android:label="Signup">

        <!-- Navigate to Verify Email after successful signup -->
        <action
            android:id="@+id/action_signupFragment_to_verifyEmailFragment"
            app:destination="@id/verifyEmailFragment"
            app:enterAnim="@android:anim/slide_in_left"
            app:exitAnim="@android:anim/slide_out_right">

            <!-- Pass email argument to VerifyEmailFragment -->
            <argument
                android:name="email"
                app:argType="string"
                android:defaultValue="" />
        </action>
    </fragment>

    <!-- Verify Email Fragment -->
    <fragment
        android:id="@+id/verifyEmailFragment"
        android:name="com.example.androidapp.ui.auth.signup.VerifyEmailFragment"
        android:label="Verify Email">

        <!-- Navigate to Home after verification -->
        <action
            android:id="@+id/action_verifyEmailFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/signupFragment"
            app:popUpToInclusive="true"/>

        <argument
            android:name="email"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <!-- Home Fragment -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.androidapp.ui.home.HomeFragment"
        android:label="Home">

        <!-- Navigate back to Login on logout -->
        <action
            android:id="@+id/action_homeFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true"/>
    </fragment>

</navigation>
